{
  "name": "webpack-ssr-templet",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --config webpack.config.dev.ts",
    "start:ssr": "ts-node scripts/devSsr.ts",
    "build:client": "webpack --config webpack.config.prod.ts",
    "build:ssr": "webpack --config webpack.config.server.ts --mode production",
    "build": "npm run build:client && npm run build:ssr",
    "preview:ssr": "node dist/server/server.js",
    "preview": "serve -s dist/client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "core-js": "^3.49.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.29.7",
    "@babel/plugin-transform-optional-chaining": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.29.2",
    "@types/dotenv-webpack": "^7.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/progress-bar-webpack-plugin": "^2.1.6",
