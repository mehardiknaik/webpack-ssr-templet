    "progress-bar-webpack-plugin": "^2.1.0",
    "serve": "^14.2.6",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "typescript-plugin-css-modules": "^5.2.0",
    "webpack": "^5.107.1",
    "webpack-bundle-analyzer": "^5.3.0",
